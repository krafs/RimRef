<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Refasmer" Version="2.0.3" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <!-- Overrides the vulnerable version that NuGet.Packaging depends on. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\package\**" LinkBase="package" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
